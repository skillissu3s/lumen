# Encrypts stored GitHub tokens. Use a long random string in production.
APP_SECRET=
# Email of the first admin account, created on start.
ADMIN_EMAIL=
# Password for that admin account.
ADMIN_PASSWORD=
# Display name for the admin.
ADMIN_NAME=
# Public base URL, e.g. https://lumen.example.com. Also enables secure cookies on https.
PUBLIC_URL=
# Port the server listens on.
PORT=3000
# Folder for the SQLite database, workspace and secrets.
DATA_DIR=/data
# How long a sign-in lasts, in days.
SESSION_DAYS=30
# How long an invite link stays valid, in days.
INVITE_DAYS=7
# Largest file the app will accept, in megabytes.
MAX_FILE_MB=2
# Send cookies only over HTTPS. Leave unset: it turns on by itself when PUBLIC_URL is https.
# SECURE_COOKIES=
# Trust X-Forwarded-* headers from a reverse proxy.
TRUST_PROXY=true
# Email delivery for sign-in codes, password resets and invite emails. Set one of
# SMTP_URL (e.g. smtps://user:pass@host) or SMTP_HOST / SMTP_PORT / SMTP_USER /
# SMTP_PASS. MAIL_FROM defaults to SMTP_USER.
SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE= (defaults to true when SMTP_PORT is 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# Development: with no SMTP configured, print emails to the server log.
MAIL_LOG_CODES=
# Tests: also append each email as one JSON line { to, subject, text, code? } here.
# MAIL_CAPTURE_FILE=
