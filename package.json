{
  "name": "lumen",
  "version": "0.2.0",
  "private": true,
  "description": "A personal productivity app — tasks, calendar, docs and chat — stored as plain text in your own GitHub repository, with plugins for the rest.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "test": "node --test",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron .",
    "desktop:build": "vite build && electron-builder",
    "desktop:publish": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "nodemailer": "^10.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.15",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "main": "desktop/main.js",
  "author": {
    "name": "skillissu3s",
    "email": "skillissu3s@users.noreply.github.com"
  },
  "build": {
    "appId": "app.lumen.desktop",
    "productName": "Lumen",
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "dist/**",
      "package.json",
      "!**/*.map",
      "!**/*.test.js"
    ],
    "icon": "desktop/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Lumen-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "artifactName": "Lumen.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "skillissu3s <skillissu3s@users.noreply.github.com>",
      "artifactName": "Lumen.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "skillissu3s",
        "repo": "lumen",
        "releaseType": "draft"
      }
    ],
    "deb": {
      "artifactName": "lumen.${ext}"
    }
  },
  "homepage": "https://github.com/skillissu3s/lumen"
}
